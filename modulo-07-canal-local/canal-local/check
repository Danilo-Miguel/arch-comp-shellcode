#!/usr/bin/exec-suid -- /bin/bash -p
set -u

PAYLOAD=/home/hacker/payload.bin
if [ ! -s "$PAYLOAD" ]; then
    echo "Crie /home/hacker/payload.bin primeiro."
    exit 1
fi

gcc -O2 -Wall /challenge/run_payload.c -o /tmp/run_payload
output=$(printf 'printf CANAL_LOCAL_OK; exit\n' | timeout 3 /tmp/run_payload "$PAYLOAD" 2>&1) || true
if [[ "$output" == *CANAL_LOCAL_OK* ]]; then
    echo "Correto! Flag:"
    cat /flag
else
    echo "O shell nao respondeu pelo canal local."
    exit 1
fi