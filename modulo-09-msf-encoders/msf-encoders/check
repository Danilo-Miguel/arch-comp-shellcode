#!/usr/bin/exec-suid -- /bin/bash -p
set -u

PAYLOAD=/home/hacker/payload.bin
if [ ! -s "$PAYLOAD" ]; then
    echo "Crie /home/hacker/payload.bin primeiro."
    exit 1
fi

# Restricao de bad char: nenhum byte 0x00 no payload.
if od -An -tx1 -v "$PAYLOAD" | grep -qw "00"; then
    echo "Payload rejeitado: contem o byte proibido 0x00. Use um encoder / -b '\\x00'."
    exit 1
fi

gcc -O2 -Wall /challenge/run_payload.c -o /tmp/run_payload
output=$(/tmp/run_payload "$PAYLOAD" 2>&1)
echo "--- saida do payload ---"
echo "$output"
echo "------------------------"
if echo "$output" | grep -q "MSF_ENC_OK"; then
    echo "Correto! Flag:"
    cat /flag
else
    echo "Esperado: payload sem 0x00 que produza MSF_ENC_OK."
    exit 1
fi
