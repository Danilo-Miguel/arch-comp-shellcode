#!/usr/bin/exec-suid -- /bin/bash -p
set -u

PAYLOAD=/home/hacker/payload.bin
if [ ! -s "$PAYLOAD" ]; then
    echo "Crie /home/hacker/payload.bin primeiro."
    exit 1
fi
if ! od -An -tx1 "$PAYLOAD" | tr -d ' \n' | grep -q '00'; then
    :
else
    echo "Payload rejeitado: encontrou byte 0x00."
    exit 1
fi

gcc -O2 -Wall /challenge/run_payload.c -o /tmp/run_payload
output=$(printf 'printf NULL_FREE_OK; exit\n' | timeout 3 /tmp/run_payload "$PAYLOAD" 2>&1) || true
if [[ "$output" == *NULL_FREE_OK* ]]; then
    echo "Correto! Flag:"
    cat /flag
else
    echo "O payload nao abriu um shell funcional."
    exit 1
fi